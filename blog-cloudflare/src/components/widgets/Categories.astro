---
import { getTaxonomyTermsWithCacheHint } from "emdash";

interface Props {
	showCount?: boolean;
	hierarchical?: boolean;
}

const { showCount = true } = Astro.props;

const { data: categories, cacheHint } = await getTaxonomyTermsWithCacheHint(
	"category",
	{ includeCounts: showCount },
);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<ul class="widget-categories">
	{
		categories.length > 0 ? (
			categories.map((category) => (
				<li>
					<a href={`/category/${category.slug}`} class="widget-categories__link">
						{category.label}
					</a>
					{showCount && category.count !== undefined && (
						<span class="widget-categories__count">({category.count})</span>
					)}
				</li>
			))
		) : (
			<li class="widget-categories__empty">まだカテゴリーはありません</li>
		)
	}
</ul>
