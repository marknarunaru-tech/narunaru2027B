---
/**
 * Monthly and yearly archives: /archives/2026/07 and /archives/2026.
 * The sidebar's アーカイブ widget links here. Months follow the Japan-time
 * calendar, matching the dates shown everywhere else on the site.
 */
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";
import { siteMonthStart } from "../../utils/locale";

const PERIOD = /^(\d{4})(?:\/(\d{2}))?$/;
const match = PERIOD.exec((Astro.params.period ?? "").replace(/\/$/, ""));
const year = match ? Number(match[1]) : NaN;
const month = match?.[2] ? Number(match[2]) : null;

if (!match || year < 1970 || year > 9999 || (month !== null && (month < 1 || month > 12))) {
	return Astro.rewrite("/404");
}

const start = month ? siteMonthStart(year, month) : siteMonthStart(year, 1);
const end = month ? siteMonthStart(year, month + 1) : siteMonthStart(year + 1, 1);
const label = month ? `${year}年${month}月` : `${year}年`;
const basePath = month
	? `/archives/${year}/${String(month).padStart(2, "0")}`
	: `/archives/${year}`;

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	where: {
		published_at: { gte: start.toISOString(), lt: end.toISOString() },
	},
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// A month with no posts has no archive page (the widget never links to one).
if (posts.length === 0 && !cursor) {
	return Astro.rewrite("/404");
}

const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);
const postsWithTags = posts.map((post) => ({
	post,
	tags: (tagsByEntry.get(post.data.id) ?? []).map((t) => ({
		slug: t.slug,
		label: t.label,
	})),
}));
---

<Base
	title={`${label}の記事`}
	description={`${label}に公開した記事の一覧`}
>
	<header class="band intro">
		<div class="frame archive-intro">
			<div class="archive-intro__text">
				<p class="eyebrow">アーカイブ</p>
				<h1 class="intro__title">{label}</h1>
				<p class="intro__lead">
					{label}に公開した記事を、新しい順に並べています。
				</p>
			</div>
			<a href="/posts" class="arrow-link">
				記事一覧
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M5 12h14"></path>
					<path d="m12 5 7 7-7 7"></path>
				</svg>
			</a>
		</div>
	</header>

	<section class="band section">
		<div class="frame">
			{
				postsWithTags.length > 0 ? (
					<>
						<div class="post-grid">
							{postsWithTags.map(({ post, tags }) => (
								<PostCard post={post} tags={tags} />
							))}
						</div>
						<Pagination basePath={basePath} cursor={cursor} nextCursor={nextCursor} />
					</>
				) : (
					<div class="empty-state">
						<h2 class="empty-state__title">
							{cursor ? "これ以上の記事はありません" : "まだ記事がありません"}
						</h2>
						<p class="empty-state__text">
							{cursor
								? "このページより先に記事はありません。"
								: `${label}に公開した記事はありません。`}
						</p>
						<div class="empty-state__actions">
							<a href={cursor ? basePath : "/posts"} class="btn btn--ghost">
								{cursor ? "最初のページへ戻る" : "記事一覧を見る"}
							</a>
						</div>
					</div>
				)
			}
		</div>
	</section>
</Base>

<style>
	.archive-intro {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		align-items: last baseline;
		justify-content: space-between;
		gap: var(--spacing-5) var(--spacing-10);
	}

	.archive-intro__text {
		min-width: 0;
	}
</style>
